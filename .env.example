
# Troha's settings for docker compose: copy to .env and fill in. Never commit .env.
# (Comments must be on their own lines.)

# REQUIRED. Everything in the database is sealed with this key: back it up apart
# from the backups, and never change it. Make one with:
#   docker compose run --rm --no-deps troha-server python -m troha_server keygen
TROHA_SECRET_KEY=

# Ports on this computer (HTTP, and HTTPS once there's a domain).
TROHA_HTTP_PORT=8080
TROHA_HTTPS_PORT=8443

# ":80" serves plain HTTP. A domain (e.g. troha.example.com) makes Caddy fetch an
# HTTPS certificate by itself (see readme.md).
TROHA_SITE_ADDRESS=:80

# The address people open Troha at (for links in emails), and true once it's HTTPS.
TROHA_PUBLIC_URL=http://localhost:8080
TROHA_SECURE_COOKIES=false

# Email for password resets and email changes. No host: emails go to the server's log.
# Security: starttls (usually port 587), ssl (465) or none.
TROHA_SMTP_HOST=
TROHA_SMTP_PORT=587
TROHA_SMTP_SECURITY=starttls
TROHA_SMTP_USER=
TROHA_SMTP_PASSWORD=
TROHA_SMTP_FROM=

# Paying for days of license: none (off; license codes still work). PayPal comes later.
TROHA_PAYMENTS=none

# The nightly backup: the hour it runs (in TZ, e.g. Europe/London) and how many are kept.
TZ=Etc/UTC
TROHA_BACKUP_HOUR=3
TROHA_BACKUP_KEEP=14
